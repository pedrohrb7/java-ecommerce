{
	"info": {
		"name": "Java Commerce API",
		"description": "JWT auth endpoints (register/login/refresh/logout) and protected demo endpoints for the java_commerce/api Spring Boot service. Login/Refresh requests auto-populate the accessToken/refreshToken collection variables via test scripts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "accessToken", "value": "", "type": "string" },
		{ "key": "refreshToken", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Creates a new user. `role` must be `CUSTOMER` or `SELLER` (ADMIN cannot self-register). `password` must be at least 8 characters. Returns 201 with the created user (no tokens)."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set(\"accessToken\", json.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", json.refreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Authenticates a user and returns an access/refresh token pair. On success, the test script stores both tokens in the `accessToken` / `refreshToken` collection variables for use by the other requests."
					},
					"response": []
				},
				{
					"name": "Refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set(\"accessToken\", json.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", json.refreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "refresh"]
						},
						"description": "Exchanges a valid refresh token for a new access/refresh token pair. Updates the collection variables on success."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "logout"]
						},
						"description": "Revokes the given refresh token. Returns 204 No Content."
					},
					"response": []
				}
			]
		},
		{
			"name": "Demo",
			"item": [
				{
					"name": "Me",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me"]
						},
						"description": "Returns the authenticated user's id/email/role. Requires a valid access token (any role)."
					},
					"response": []
				},
				{
					"name": "Admin Ping",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/ping",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "ping"]
						},
						"description": "Returns \"pong\". Requires the ADMIN role - since registration only allows CUSTOMER/SELLER, this needs a user promoted to ADMIN directly in MongoDB to succeed; otherwise expect 403."
					},
					"response": []
				}
			]
		}
	]
}
